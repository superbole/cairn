      "Bash(git show *)",
      "Bash(git worktree *)",
      "Bash(sh plugins/cairn/hooks/run.sh *)",
      "Bash(python plugins/cairn/tools/*)",
      "Bash(python3 plugins/cairn/tools/*)",
      "Bash(git push origin afk/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)"
