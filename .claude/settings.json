      "PowerShell(git push origin)",
      "PowerShell(git push -*)",
      "PowerShell(git push * -*)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *:)",
      "PowerShell(git push *: *)",
      "PowerShell(git push *://*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *heads/*)",
      "PowerShell(git push *HEAD*)",
      "PowerShell(git push *@*)",
      "PowerShell(git push *afk/* *)",
      "PowerShell(git push *\"*)",
      "PowerShell(git push *'*)",
      "PowerShell(git push *`*)",
      "PowerShell(git push *$*)",
      "PowerShell(git push *{*)",
      "PowerShell(git -* push*)",
