      "PowerShell(python *sync_backlog*)",
      "PowerShell(python3 *sync_backlog*)",
      "PowerShell(py *sync_backlog*)",
      "PowerShell(sh *sync_backlog*)",
      "PowerShell(& *sync_backlog*)"
