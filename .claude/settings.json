      "Bash(git push *\"*)",
      "Bash(git push *'*)",
      "Bash(git push *`*)",
      "Bash(git push *\\*)",
      "Bash(git push *$*)",
      "Bash(git push *{*)",
      "Bash(git push *[*)",
      "Bash(git push *?*)",
      "Bash(git -* push*)",
      "Bash(git.exe push*)",
      "Bash(*/git push*)",
      "Bash(*/git.exe push*)",
      "Bash(sh -c *push*)",
